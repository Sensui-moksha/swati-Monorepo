{
  "name": "swathi-publications-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for Swathi Publications",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:connect": "tsx src/database/connect.ts",
    "docs:generate": "tsx src/docs/generate.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@azure/storage-blob": "^12.33.0",
    "@elastic/elasticsearch": "^9.4.2",
    "@google-cloud/storage": "^7.21.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.3",
    "chokidar": "^5.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "morgan": "^1.12.0",
    "multer": "^2.4.0",
    "natural": "^8.1.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "otplib": "^13.4.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-mongo-sanitize": "^1.3.2",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/hpp": "^0.2.7",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/natural": "^5.1.5",
    "@types/node": "^20.14.12",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.24",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "uuid": "$uuid",
    "brace-expansion": "^1.1.18",
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "^5.0.9"
    },
    "swagger-jsdoc": {
      "brace-expansion": "^5.0.9"
    },
    "fast-uri": "^4.2.1",
    "js-yaml": "^4.3.2",
    "browserslist": "^4.29.0",
    "baseline-browser-mapping": "^2.11.25",
    "qs": "^6.16.0"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
