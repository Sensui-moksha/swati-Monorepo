# ============================================================
# Application
# ============================================================
NODE_ENV=development
PORT=3000
APP_NAME=Swathi Publications
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ============================================================
# Database (MongoDB)
# ============================================================
MONGODB_URI=mongodb://localhost:27017/swathi-publications

# ============================================================
# JWT Security
# Secrets MUST be at least 32 characters long
# ============================================================
JWT_ACCESS_SECRET=your-super-secret-access-jwt-key-must-be-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-must-be-32-chars-long
JWT_REFRESH_EXPIRY=7d

# ============================================================
# CORS
# ============================================================
CORS_ORIGIN=http://localhost:5173

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# Email (Nodemailer / SMTP)
# Leave blank to disable email sending
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@swathipublications.com
SUPPORT_EMAIL=support@swathipublications.com

# ============================================================
# File Upload (Local Storage)
# ============================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ============================================================
# Cloud Storage — Amazon S3 (optional)
# If set, S3 will be used instead of local file storage
# ============================================================
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ============================================================
# Cloud Storage — Cloudflare R2 (optional)
# ============================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ============================================================
# Cloud Storage — Google Cloud Storage (optional)
# ============================================================
GCS_PROJECT_ID=
GCS_KEY_FILENAME=
GCS_BUCKET_NAME=

# ============================================================
# Cloud Storage — Azure Blob Storage (optional)
# ============================================================
AZURE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

# ============================================================
# Storage — Public URL (for self-hosted / local provider)
# Used to generate public download URLs for uploaded files
# ============================================================
STORAGE_PUBLIC_URL=http://localhost:3000

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=info

# ============================================================
# Swagger / API Docs
# ============================================================
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs

# ============================================================
# Payment Integration
# ============================================================
PAYMENT_PROVIDER=dummy