# ==============================================================================
# Swati Monorepo Environment Variables
# Copy these into Coolify > Environment Variables or into your local .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CRITICAL REQUIRED VARIABLES (Application WILL NOT start without these!)
# ------------------------------------------------------------------------------

# MongoDB Connection String (Required)
# Example for local/docker: mongodb://localhost:27017/swathi-publications
# Example for MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/swathi?retryWrites=true&w=majority
# Example for Coolify internal database: mongodb://coolify-db:27017/swathi
MONGODB_URI=mongodb://localhost:27017/swathi-publications

# JWT Access Secret (Required - MUST be at least 32 characters!)
JWT_ACCESS_SECRET=e7fa8e2188de74619506edee76a58f15b443c05b6553aebbcc3235b14a51b143

# JWT Refresh Secret (Required - MUST be at least 32 characters!)
JWT_REFRESH_SECRET=544cfdf070e649d1f2ecfec2e349bf8cf01d0b42806442b198716b2abf2f8bd7

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME CONFIGURATION (Defaults provided, adjust as needed)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
CORS_ORIGIN=*
LOG_LEVEL=info

# JWT Expiration Durations
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# API Rate Limiting (100 requests per 15 minutes window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis Connection (Required for background workers and caching)
# Default: redis://localhost:6379 (or redis://coolify-redis:6379 in Coolify)
REDIS_URL=redis://localhost:6379

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs

# Payment Provider: dummy | stripe | razorpay
PAYMENT_PROVIDER=dummy

# ------------------------------------------------------------------------------
# 3. FILE STORAGE (Defaults to local storage)
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Cloud Storage - AWS S3 / Cloudflare R2 / MinIO (Optional)
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# ------------------------------------------------------------------------------
# 4. EMAIL / SMTP NOTIFICATIONS (Optional - leave blank if not configured)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Swathi Publications" <noreply@swathipublications.com>

# ------------------------------------------------------------------------------
# 5. PDF PROCESSING & OPTIMIZATION (Defaults provided)
# ------------------------------------------------------------------------------
PDF_SSD_CACHE_DIR=/mnt/ssd-cache/pdf
PDF_OPTIMIZED_DIR=./storage/optimized
PDF_CACHE_MAX_SIZE_GB=100
PDF_CACHE_TTL_HOURS=72
PDF_HOT_FILE_THRESHOLD=10
PDF_OPTIMIZATION_PROVIDER=auto
PDF_OPTIMIZATION_CONCURRENCY=2
PDF_PREPROCESSING_CRON=0 2 * * *
