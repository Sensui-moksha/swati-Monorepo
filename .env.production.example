# ---------------------------------------
# Production Environment Variables
# ---------------------------------------

# App
NODE_ENV=production
PORT=3000
APP_URL=https://app.swathipublications.com

# Database
MONGODB_URI=mongodb://mongo:27017/swathi
REDIS_URL=redis://redis:6379
ELASTICSEARCH_URL=http://elasticsearch:9200
ES_PASSWORD=change_this_secure_password

# Authentication (JWT)
JWT_SECRET=super_secure_random_string_here
JWT_EXPIRES_IN=7d

# Storage (30TB scale requires a dedicated path or S3)
STORAGE_ROOT=/var/data/swathi
STORAGE_PUBLIC_URL=https://app.swathipublications.com/documents

# Security
CORS_ORIGIN=https://app.swathipublications.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Monitoring
ENABLE_METRICS=true
